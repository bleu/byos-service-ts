# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/byos_dev
REDIS_URL=redis://localhost:6379
CHAIN_ID=31337

# Listeners
PUBLIC_ADDR_PORT=9585
INTERNAL_ADDR_PORT=9586

# Optional: bearer token for /solve and /notify
# SOLVE_BEARER_TOKEN=

# Chain connectivity
# CHAIN_ID is the one knob that selects a chain. SETTLEMENT_ADDRESS,
# ORDERBOOK_URL, ESCROW_ADDRESS, and TRAMPOLINE_FACTORY all resolve
# automatically from the chain. Set them only to override the defaults
# (e.g. barn/staging orderbook, not-yet-deployed chains, local dev).
# RPC_URL=
# ORDERBOOK_URL=        # overrides orderbookUrlFor(CHAIN_ID)
# ESCROW_ADDRESS=       # overrides escrowAddressFor(CHAIN_ID); required if chain has no entry
# SETTLEMENT_ADDRESS=   # overrides settlementAddressFor(CHAIN_ID)
# TRAMPOLINE_FACTORY=   # overrides trampolineFactoryFor(CHAIN_ID); required if chain has no entry
# MIN_COLLATERAL=       # overrides the chain's default minimum collateral
# DEFAULT_GAS_PRICE=

# Rate limiting (ADR-0015). Defaults are sized from the reference client's
# poll volume, not measured traffic — see COW-1265 before going public.
RATE_LIMIT_WINDOW_SECS=60
# Loose in-app backstop; the primary per-IP limit is at the Cloudflare edge.
RATE_LIMIT_IP_PER_WINDOW=6000
# Escrow wei buying one unit of throughput. Independent of MIN_COLLATERAL,
# which may legitimately be 0.
RATE_UNIT_WEI=100000000000000000
RATE_PER_UNIT=300
RATE_MIN_PER_WINDOW=120
RATE_MAX_PER_WINDOW=3000

# Request-path escrow balance cache
BALANCE_REFRESH_INTERVAL_SECS=60
BALANCE_EVICTION_SECS=3600
BALANCE_NEGATIVE_TTL_SECS=600
# A tick makes ceil(cap / batch size) multicalls back to back.
BALANCE_ACTIVE_SET_MAX=10000
BALANCE_REFRESH_BATCH_SIZE=50

# Timing
VALIDATION_INTERVAL_SECS=12
DROPPED_RETENTION=1h
RETENTION_SWEEP_INTERVAL_SECS=300
MAX_PROPOSAL_LIFETIME_SECS=300
EXECUTING_TIMEOUT=5m
MIN_PROPOSAL_SCORE=0

# Operator (Track A penalty loop)
# OPERATOR_PRIVATE_KEY=

# Logging
LOG_LEVEL=info
JSON_LOGS=false
