{
	"name": "byos-service-ts",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.3.0",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"scripts": {
		"build": "pnpm -r run build",
		"dev": "docker compose up -d --wait postgres redis && pnpm --filter @byos/byos run dev",
		"test": "vitest run --project unit",
		"test:db": "vitest run --project db",
		"test:redis": "vitest run --project redis",
		"test:integration": "vitest run --project integration",
		"test:onchain": "vitest run --project onchain",
		"test:e2e": "vitest run --project e2e",
		"test:watch": "vitest",
		"e2e:up": "./scripts/e2e-stack.sh up -d --build --wait",
		"e2e:down": "./scripts/e2e-stack.sh down -v",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:openapi": "npx --yes @apidevtools/swagger-cli@4 validate apps/byos/openapi.yml && npx --yes @stoplight/spectral-cli@6 lint apps/byos/openapi.yml",
		"typecheck": "tsc -b",
		"format": "biome format --write .",
		"db:generate": "pnpm --filter @byos/byos run db:generate",
		"db:migrate": "pnpm --filter @byos/byos run db:migrate"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"tsup": "^8.0.0",
		"typescript": "^5.8.0",
		"vitest": "^3.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
