ORDERBOOK_URL=http://host.docker.internal:8080
BYOS_URL=http://host.docker.internal:9585
RPC_URL=
SUBSOLVER_PRIVATE_KEY=
CONFIG_PATH=config.toml
FYND_URL=http://fynd:3000
FYND_SLIPPAGE_BPS=50
# Same-basket pairs use this value; unconfigured chains use ordinary slippage.
CORRELATED_SLIPPAGE_BPS=5
FYND_QUOTE_CONCURRENCY=32
FYND_MAX_QUOTE_AGE_SECONDS=10
GPV2_SETTLEMENT=
BYOS_REQUESTS_PER_MINUTE=100
BYOS_READ_RESERVE=10
PROPOSAL_REFRESH_INTERVAL_SECONDS=15

# HTTP listener in every discovery mode; GET /healthz reports startup readiness.
SOLVE_PORT=3001

# Parallel BYOS POSTs across all orders (each waits for inline validation).
BYOS_SUBMISSION_CONCURRENCY=3
# Stop starting POSTs this many milliseconds before the /solve deadline.
SUBSOLVER_DEADLINE_BUFFER_MS=1000
