# BYOS service URL
BYOS_URL=http://localhost:3000

# CoW Protocol orderbook URL
ORDERBOOK_URL=https://api.cow.fi/mainnet

# Ethereum RPC endpoint (required for on-chain balance reads and trampoline resolution)
RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# CoW Protocol settlement contract address
SETTLEMENT_ADDRESS=0x9008D19f58AAbD9eD0D60971565AA8510560ab41

# Private key of the subsolver account (must be registered in BYOS with sufficient escrow)
SUBSOLVER_PRIVATE_KEY=0x...

# EIP-712 domain: chain ID and TrampolineFactory address
CHAIN_ID=1
TRAMPOLINE_FACTORY=0x0000000000000000000000000000000000000000

# USDC and USDT token addresses
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# Optional — defaults shown
# MAX_PROPOSAL_LIFETIME_MS=600000
# ORDERBOOK_POLL_INTERVAL_MS=2000
# PROPOSAL_SYNC_INTERVAL_MS=10000
# LOG_LEVEL=info
# LOG_PRETTY=false   # set to true for human-readable output in development
