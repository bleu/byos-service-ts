{
	"name": "@byos/byos",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js",
		"./src/*": "./src/*",
		"./test/*": "./test/*"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch --onSuccess 'node dist/index.js'",
		"start": "node dist/index.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@byos/common": "workspace:*",
		"@hono/node-server": "^1.0.0",
		"bullmq": "^5.0.0",
		"dotenv": "^16.0.0",
		"drizzle-orm": "^0.40.0",
		"hono": "^4.0.0",
		"ioredis": "^5.0.0",
		"pino": "^9.0.0",
		"postgres": "^3.4.0",
		"viem": "^2.0.0",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"drizzle-kit": "^0.30.0",
		"tsup": "^8.0.0",
		"typescript": "^5.8.0"
	}
}
