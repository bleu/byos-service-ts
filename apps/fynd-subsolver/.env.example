BYOS_URL=http://localhost:9585
RPC_URL=https://your-rpc-url
SUBSOLVER_PRIVATE_KEY=0xyour-private-key
GPV2_SETTLEMENT=0x9008d19f58aabd9ed0d60971565aa8510560ab41
CHAIN_ID=56
TRAMPOLINE_FACTORY=0x934b5d82f45F154936E3f9e0aBc803d2fa4ad49c
FYND_URL=http://fynd:3000

# Discovery method: "orderbook" or "aws"
DISCOVERY_METHOD=orderbook

# For orderbook discovery: the CoW orderbook API base URL
# DISCOVERY_URL=https://api.cow.fi/bnb

# For AWS discovery: the S3 base URL (without /autopilot suffix)
# DISCOVERY_URL=https://your-s3-bucket/prod/bnb

# Fynd sidecar
FYND_SLIPPAGE_BPS=50
FYND_QUOTE_CONCURRENCY=32
FYND_MAX_QUOTE_AGE_SECONDS=10

# BYOS request budget
BYOS_REQUESTS_PER_MINUTE=100
BYOS_READ_RESERVE=10

# Proposal lifecycle
PROPOSAL_TTL_SECONDS=60
PROPOSAL_REFRESH_INTERVAL_SECONDS=15

# Polling
POLL_INTERVAL_SECONDS=2

# Logging
LOG_LEVEL=info
JSON_LOGS=true
