BYOS_URL=http://localhost:9585
RPC_URL=https://your-rpc-url
SUBSOLVER_PRIVATE_KEY=0xyour-private-key
GPV2_SETTLEMENT=0x9008d19f58aabd9ed0d60971565aa8510560ab41
CHAIN_ID=56
TRAMPOLINE_FACTORY=0x934b5d82f45F154936E3f9e0aBc803d2fa4ad49c

# Discovery method: "orderbook", "aws", or "solve"
DISCOVERY_METHOD=orderbook

# When DISCOVERY_METHOD=orderbook: CoW orderbook API base URL
# When DISCOVERY_METHOD=aws: S3 snapshot directory URL (including /autopilot; appends /<auctionId>.json)
DISCOVERY_URL=https://api.cow.fi/bnb
# DISCOVERY_URL=https://your-s3-bucket/prod/bnb/autopilot

# Binance credentials
BINANCE_API_KEY=your-api-key
BINANCE_SECRET_KEY=your-secret-key

# Binance quote settings
BINANCE_SLIPPAGE_BPS=50
# Same-basket pairs use this value; unconfigured chains use ordinary slippage.
CORRELATED_SLIPPAGE_BPS=5
BINANCE_QUOTE_CONCURRENCY=32

# BYOS request budget
BYOS_REQUESTS_PER_MINUTE=100
BYOS_READ_RESERVE=10

# Proposal lifecycle
PROPOSAL_TTL_SECONDS=60
PROPOSAL_REFRESH_INTERVAL_SECONDS=15

# Polling
POLL_INTERVAL_SECONDS=2

# Logging
LOG_LEVEL=info
JSON_LOGS=true

# Selection: newly seen sell orders plus top N by relative spread
CLOSE_TO_EXECUTION_TOP_N=20

# Required in solve mode; DISCOVERY_URL is optional in this mode
# SUBSOLVER_BEARER=replace-with-a-secret
SOLVE_PORT=3001
